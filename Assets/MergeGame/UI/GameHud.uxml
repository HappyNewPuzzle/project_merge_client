<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="GameHud.uss" />
    <ui:VisualElement class="screen">
        <ui:Label text="Project Merge" class="title" />
        <ui:Label name="status" text="서버 상태를 불러오는 중입니다." class="status" />
        <ui:VisualElement class="summary">
            <ui:Label name="economy" text="에너지 0 · 코인 0" />
            <ui:Label name="quest" text="퀘스트" />
            <ui:Label name="friend-code" text="친구 코드" />
        </ui:VisualElement>
        <ui:VisualElement name="board" class="board" />
        <ui:VisualElement class="actions">
            <ui:Button name="daily" text="일일 보상" />
            <ui:Button name="claim" text="퀘스트 보상" />
            <ui:TextField name="friend-input" label="친구 코드" max-length="8" />
            <ui:Button name="add-friend" text="친구 추가" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
