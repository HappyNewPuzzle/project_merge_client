.screen { flex-grow: 1; width: 100%; padding: 12px; overflow: hidden; background-color: rgba(250, 225, 184, 0); color: rgb(104, 67, 36); }
.room-background { position: absolute; left: 0; right: 0; top: 0; bottom: 0; -unity-background-scale-mode: scale-and-crop; }
.top-hud { width: 100%; max-width: 620px; align-self: center; flex-direction: row; flex-wrap: wrap; justify-content: space-between; align-items: center; margin-bottom: 6px; }
.game-title { display: none; font-size: 24px; -unity-font-style: bold; color: rgb(139, 78, 37); margin-right: 12px; }
.top-hud { justify-content: center; }
.currency-list { flex-direction: row; flex-wrap: wrap; }
.currency-capsule { min-width: 142px; height: 56px; flex-direction: row; align-items: center; padding-right: 19px; padding-left: 9px; margin-left: 7px; margin-right: 7px; margin-bottom: 3px; background-color: rgb(255, 249, 232); border-width: 2px; border-color: rgb(218, 161, 87); border-radius: 28px; }
.currency-icon { width: 46px; height: 46px; margin-right: 9px; -unity-background-scale-mode: scale-to-fit; }
.currency-value { font-size: 22px; -unity-font-style: bold; color: rgb(91, 56, 28); }
.status-panel { width: 100%; max-width: 620px; align-self: center; flex-direction: row; align-items: center; justify-content: space-between; padding: 10px; margin-bottom: 10px; background-color: rgb(255, 238, 204); border-width: 1px; border-color: rgb(213, 147, 79); border-radius: 14px; }
.status { color: rgb(139, 78, 37); white-space: normal; }
.status-action { margin-left: 8px; background-color: rgb(225, 153, 65); color: white; border-radius: 12px; }
.quest-card { width: 100%; max-width: 620px; min-height: 52px; align-self: center; flex-direction: row; align-items: center; justify-content: space-between; padding: 7px; margin-bottom: 2px; background-color: rgb(255, 250, 234); border-width: 2px; border-color: rgb(218, 161, 87); border-radius: 17px; }
.quest-copy { flex-grow: 1; margin-right: 8px; }
.section-eyebrow { font-size: 13px; color: rgb(169, 96, 39); -unity-font-style: bold; }
.quest-title { font-size: 17px; color: rgb(91, 56, 28); white-space: normal; }
.quest-action { min-width: 92px; height: 34px; margin-left: 7px; background-color: rgb(234, 151, 48); color: white; border-radius: 17px; -unity-font-style: bold; font-size: 14px; }
.play-area { width: 100%; align-items: center; }
.generator-panel { align-items: center; margin-top: 0; margin-bottom: 0; padding-top: 0; padding-bottom: 0; }
.generator-title { font-size: 17px; -unity-font-style: bold; color: rgb(133, 75, 35); margin-bottom: 0; }
.generator { width: 310px; height: 210px; padding: 2px; -unity-background-scale-mode: scale-to-fit; background-color: rgb(255, 246, 215); border-width: 5px; border-color: rgb(222, 139, 36); border-radius: 32px; transition-property: scale, opacity, border-color; transition-duration: 0.10s; transition-timing-function: ease-out; }
.generator:hover { border-color: rgb(255, 198, 75); scale: 1.03 1.03; }
.generator:active { scale: 0.96 0.96; }
.generator:disabled { opacity: 0.55; }
.generator-producing { scale: 0.92 0.92; opacity: 0.72; }
.generator-rebound { scale: 1.06 1.06; }
.generator-hint { font-size: 12px; color: rgb(164, 102, 46); margin-top: 0; margin-bottom: 0; }
.board-frame { width: 90%; max-width: 680px; align-self: center; padding: 4px; background-color: rgb(244, 193, 112); border-width: 4px; border-color: rgb(190, 116, 46); border-radius: 22px; }
.board { position: relative; flex-direction: row; flex-wrap: wrap; width: 100%; align-self: center; }
.board-slot { width: 24.2%; min-width: 54px; height: 112px; margin: 0.4%; align-items: center; justify-content: center; overflow: hidden; border-width: 2px; border-color: rgb(231, 196, 139); border-radius: 18px; transition-property: scale, opacity, border-color, background-color; transition-duration: 0.12s; transition-timing-function: ease-out; }
.board-item-art { width: 88%; height: 88%; -unity-background-scale-mode: scale-to-fit; transition-property: scale, opacity; transition-duration: 0.12s; transition-timing-function: ease-out; }
.board-slot-empty { background-color: rgb(255, 241, 211); border-color: rgb(220, 175, 110); }
.board-slot-item { background-color: rgb(255, 250, 234); border-color: rgb(222, 165, 88); }
.board-slot-dragging { scale: 1.07 1.07; opacity: 0.78; border-width: 4px; border-color: rgb(244, 178, 62); }
.board-slot-merge-target { scale: 1.03 1.03; border-width: 4px; border-color: rgb(111, 197, 91); background-color: rgb(239, 255, 211); }
.board-slot-returning { scale: 0.96 0.96; border-color: rgb(220, 151, 91); }
.merge-success { border-width: 4px; border-color: rgb(255, 194, 54); background-color: rgb(255, 248, 196); }
.generate-success { border-width: 4px; border-color: rgb(245, 171, 67); background-color: rgb(255, 241, 197); }
.merge-sparkle { position: absolute; color: rgb(255, 189, 42); font-size: 24px; -unity-font-style: bold; }
.sparkle-one { left: 8%; top: 5%; }
.sparkle-two { right: 8%; bottom: 4%; font-size: 18px; }
.board-debug-label { display: none; position: absolute; bottom: 2px; font-size: 9px; color: rgb(98, 65, 37); }
.show-board-debug .board-debug-label { display: flex; }
.drag-ghost { position: absolute; width: 92px; height: 92px; -unity-background-scale-mode: scale-to-fit; background-color: rgba(255, 248, 225, 0.94); border-width: 3px; border-color: rgb(240, 172, 66); border-radius: 20px; }
.mascot-area { width: 100%; max-width: 620px; align-self: center; flex-direction: row; align-items: flex-end; margin-top: 6px; transform-origin: 50% 100%; transition-property: scale, opacity; transition-duration: 0.12s; transition-timing-function: ease-out; }
.mascot-art { width: 170px; height: 170px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; }
.speech-bubble { flex-grow: 1; min-height: 96px; justify-content: center; padding: 18px; margin-left: 12px; background-color: rgb(255, 250, 234); border-width: 2px; border-color: rgb(218, 161, 87); border-radius: 25px; }
.mascot-message { font-size: 19px; color: rgb(91, 56, 28); white-space: normal; -unity-text-align: middle-left; }
.mascot-enter-start { scale: 0.95 0.95; opacity: 0; }
.mascot-enter-peak { scale: 1.03 1.03; opacity: 1; }
.compact-height .mascot-area, .very-compact-height .mascot-area { display: none; }
.bottom-navigation { width: 90%; max-width: 680px; min-height: 74px; align-self: center; flex-direction: row; margin-top: 6px; padding: 6px; background-color: rgb(255, 250, 234); border-width: 2px; border-color: rgb(218, 161, 87); border-radius: 24px; }
.navigation-tab { flex-grow: 1; height: 58px; flex-direction: column; align-items: center; justify-content: center; margin-left: 2px; margin-right: 2px; padding: 4px; background-color: rgba(255, 250, 234, 0); border-width: 0; border-radius: 18px; color: rgb(135, 89, 47); transition-property: scale, background-color; transition-duration: 0.10s; transition-timing-function: ease-out; }
.navigation-tab:active { scale: 0.97 0.97; }
.navigation-tab:disabled { opacity: 0.52; }
.navigation-tab-selected { background-color: rgb(255, 218, 126); scale: 1.04 1.04; }
.navigation-tab-selected .navigation-label { -unity-font-style: bold; color: rgb(128, 70, 29); }
.navigation-icon { display: flex; width: 32px; height: 32px; flex-shrink: 0; margin-bottom: 1px; -unity-background-scale-mode: scale-to-fit; }
.navigation-tab-selected .navigation-icon { scale: 1.06 1.06; opacity: 1; }
.navigation-label { font-size: 14px; color: rgb(135, 89, 47); -unity-text-align: middle-center; }
.feature-placeholder { display: none; }
.development-only { display: none; }
.hidden { display: none; }
.compact-height .screen { padding: 6px; }
.compact-height .top-hud { margin-bottom: 2px; }
.compact-height .game-title { display: none; }
.compact-height .top-hud { justify-content: center; }
.compact-height .currency-capsule { height: 40px; min-width: 108px; padding-right: 12px; margin-left: 4px; margin-right: 4px; margin-bottom: 0; border-radius: 20px; }
.compact-height .currency-icon { width: 32px; height: 32px; }
.compact-height .currency-value { font-size: 17px; }
.compact-height .section-eyebrow { display: none; }
.compact-height .quest-card { min-height: 34px; padding: 2px; margin-bottom: 0; border-radius: 13px; }
.compact-height .quest-title { font-size: 14px; }
.compact-height .quest-action { height: 27px; min-width: 76px; }
.compact-height .generator-panel { margin-top: 0; margin-bottom: 0; }
.compact-height .generator { width: 220px; height: 145px; padding: 1px; border-radius: 23px; }
.compact-height .generator-title { display: none; }
.compact-height .generator-hint { display: none; }
.compact-height .board-frame { padding: 3px; border-radius: 19px; }
.compact-height .board-slot { border-radius: 14px; }
.compact-height .bottom-navigation { min-height: 56px; margin-top: 3px; padding: 4px; border-radius: 18px; }
.compact-height .navigation-tab { height: 44px; padding: 2px; border-radius: 14px; }
.compact-height .navigation-label { font-size: 12px; }
.compact-height .navigation-icon { width: 24px; height: 24px; }
.very-compact-height .currency-capsule { margin-left: 4px; margin-right: 4px; }
.very-compact-height .quest-card { min-height: 31px; padding: 1px; }
.very-compact-height .generator { width: 185px; height: 120px; padding: 0; border-width: 3px; border-radius: 19px; }
.very-compact-height .bottom-navigation { min-height: 48px; padding: 3px; }
.very-compact-height .navigation-tab { height: 40px; }
